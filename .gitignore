# ============================================================
# HPCOS-GC-RECOMP
# Keep all source/runtime/module/recomp/vendor trees trackable.
# Ignore only local game data, user state, caches and build dirs.
# ============================================================

# Local build outputs
/build/
/port-build/
/port-build-*/
/.cache/
/.releases/
/.publish.*/
.build.lock
/module/
.deps/
# Local runtime/user state
/user/

# User-provided copyrighted game data
/extracted/
/iso/
*.iso
*.gcm
*.rvz
*.wbfs

# Temporary / backup files
*.log
*.bak
*.tmp
*.temp
*.old
*.orig
*.rej
*~
.DS_Store
Thumbs.db

# Editor metadata
.idea/
.vscode/
*.swp
*.swo

# This helper itself
/vendor_upstreams_and_push.py

# Generated build artifacts
/module/build-info.txt
/module/gGHSE69_recomp.so
/runtime/build-info.txt
/runtime/moderngekko-run
