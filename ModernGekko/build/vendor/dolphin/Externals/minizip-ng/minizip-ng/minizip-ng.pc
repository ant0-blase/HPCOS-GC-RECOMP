prefix=/usr/local
exec_prefix=/usr/local
libdir=/usr/local/lib
sharedlibdir=/usr/local/lib
includedir=/usr/local/include/minizip-ng

Name: minizip-ng
Description: Zip manipulation library
Version: 4.0.8

Requires.private: zlib-ng
Libs: -L${libdir} -L${sharedlibdir} -lminizip-ng
Libs.private: -llzma -lzstd
Cflags: -I${includedir}
